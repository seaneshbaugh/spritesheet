<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Generate a PNG sprite sheet and matching CSS from PNG or static GIF images.">
  <title>Sprite Sheet Generator</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="<%= asset_path('css/app.css') %>">
  <link rel="author" href="/humans.txt">
  <script type="importmap"><%= JSON.generate({ imports: { '@hotwired/stimulus' => asset_path('js/vendor/stimulus-3.2.2.js'), 'upload-controller' => asset_path('js/controllers/upload_controller.js') } }) %></script>
  <script type="module" src="<%= asset_path('js/app.js') %>"></script>
</head>
<body class="min-h-screen text-slate-900 antialiased">
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-14">
    <%= yield %>
    <footer class="mt-8 flex flex-wrap justify-between gap-3 text-xs text-slate-600">
      <a class="underline underline-offset-2 hover:text-slate-900" href="https://github.com/seaneshbaugh/spritesheet" target="_blank">View source on GitHub</a>
      <span>Background by <a class="underline underline-offset-2 hover:text-slate-900" href="https://www.svgbackgrounds.com/" target="_blank">SVG Backgrounds</a> · <a class="underline underline-offset-2 hover:text-slate-900" href="https://creativecommons.org/licenses/by/4.0/" target="_blank">CC BY 4.0</a></span>
    </footer>
  </main>
</body>
</html>
